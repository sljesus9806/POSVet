# =====================================================
# Base de datos (PostgreSQL local vía Docker Compose)
# =====================================================
POSTGRES_DB=posvet
POSTGRES_USER=posvet
POSTGRES_PASSWORD=posvet_dev
POSTGRES_PORT=5432

# URL que usa Prisma. Si cambias usuario/pass arriba, ajusta también aquí.
DATABASE_URL="postgresql://posvet:posvet_dev@localhost:5432/posvet?schema=public"

# =====================================================
# Auth (NextAuth.js v5 / Auth.js)
# =====================================================
# Generar con: openssl rand -base64 32
AUTH_SECRET="cambia-esto-en-produccion-con-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# =====================================================
# Seed inicial (usuario administrador por defecto)
# =====================================================
SEED_ADMIN_EMAIL="admin@posvet.local"
SEED_ADMIN_PASSWORD="admin12345"
SEED_ADMIN_NOMBRE="Administrador"

# =====================================================
# Facturación (CFDI 4.0)
# =====================================================
# Modo de timbrado:
#   demo      → simulado, SIN validez fiscal (por defecto; para probar el flujo)
#   facturama → timbra de verdad contra el PAC Facturama (requiere credenciales)
FACTURACION_MODO="demo"

# Serie de los folios de factura (correlativo por serie).
FACTURACION_SERIE="A"

# Claves SAT por defecto para los conceptos. 01010101 = "No existe en el catálogo"
# y H87 = "Pieza". Conviene ajustar la clave de producto/servicio al giro real.
FACTURACION_CLAVE_PROD_SERV="01010101"
FACTURACION_CLAVE_UNIDAD="H87"

# Credenciales del PAC Facturama (solo si FACTURACION_MODO=facturama).
# Son las credenciales de la API (NO las del portal web). Sandbox para pruebas,
# producción para timbrar real. El CSD del cliente se carga en la cuenta de Facturama.
#   Sandbox:    https://apisandbox.facturama.mx
#   Producción: https://api.facturama.mx
FACTURAMA_API_URL="https://apisandbox.facturama.mx"
FACTURAMA_USER=""
FACTURAMA_PASSWORD=""
