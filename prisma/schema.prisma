// Esquema Prisma - POSVet
// Módulos: Auth/Usuarios, Productos, Inventario, Clientes, Ventas (Fase 1 - MVP)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================
// EMPRESA Y UBICACIONES
// =====================================================

model Empresa {
  id            String      @id @default(cuid())
  rfc           String
  razonSocial   String
  regimenFiscal String?
  codigoPostal  String?
  direccion     String?
  email         String?
  telefono      String?
  logoUrl       String?
  activa        Boolean     @default(true)
  ubicaciones   Ubicacion[]
  usuarios      Usuario[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

enum TipoUbicacion {
  TIENDA
  BODEGA
  SUCURSAL
}

model Ubicacion {
  id                    String                 @id @default(cuid())
  empresaId             String
  nombre                String
  tipo                  TipoUbicacion
  direccion             String?
  activa                Boolean                @default(true)
  empresa               Empresa                @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  inventarios           Inventario[]
  movimientos           InventarioMovimiento[]
  transferenciasOrigen  Transferencia[]        @relation("TransferenciaOrigen")
  transferenciasDestino Transferencia[]        @relation("TransferenciaDestino")
  cajas                 Caja[]
  ventas                Venta[]
  ordenesCompra         OrdenCompra[]
  recepciones           RecepcionMercancia[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([empresaId])
}

// =====================================================
// USUARIOS, ROLES Y PERMISOS (RBAC)
// =====================================================

model Usuario {
  id               String                 @id @default(cuid())
  empresaId        String
  email            String                 @unique
  nombre           String
  passwordHash     String
  activo           Boolean                @default(true)
  twoFactorEnabled Boolean                @default(false)
  twoFactorSecret  String?
  ultimoLoginAt    DateTime?
  intentosFallidos Int                    @default(0)
  bloqueadoHasta   DateTime?
  empresa          Empresa                @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  roles            UsuarioRol[]
  intentosLogin    IntentoLogin[]
  auditLogs        AuditLog[]
  movimientos      InventarioMovimiento[]
  transferencias   Transferencia[]
  cajasAbiertas    Caja[]                 @relation("CajaAbiertaPor")
  cajasCerradas    Caja[]                 @relation("CajaCerradaPor")
  ventas           Venta[]                @relation("VentaUsuario")
  ventasCanceladas Venta[]                @relation("VentaCanceladaPor")
  ordenesCompra    OrdenCompra[]          @relation("OcCreadaPor")
  ordenesCanceladas OrdenCompra[]         @relation("OcCanceladaPor")
  recepciones      RecepcionMercancia[]
  facturasProveedorCapturadas FacturaProveedor[] @relation("FacturaProvCapturada")
  facturasProveedorCanceladas FacturaProveedor[] @relation("FacturaProvCancelada")
  pagosProveedorRegistrados ProveedorPago[]    @relation("PagoProvRegistrado")
  pagosProveedorCancelados ProveedorPago[]    @relation("PagoProvCancelado")
  abonosRegistrados   ClienteAbono[]      @relation("AbonoRegistrado")
  abonosCancelados    ClienteAbono[]      @relation("AbonoCancelado")
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([empresaId])
}

model Rol {
  id          String       @id @default(cuid())
  codigo      String       @unique // ADMIN, SUPERVISOR, CAJERO, ALMACENISTA, READONLY
  nombre      String
  descripcion String?
  sistema     Boolean      @default(false) // roles del sistema no se pueden eliminar
  permisos    RolPermiso[]
  usuarios    UsuarioRol[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Permiso {
  id          String       @id @default(cuid())
  codigo      String       @unique // formato: "modulo:accion" ej "ventas:crear"
  modulo      String // ventas, clientes, productos, etc.
  accion      String // leer, crear, editar, eliminar, autorizar
  descripcion String?
  roles       RolPermiso[]

  @@index([modulo])
}

model RolPermiso {
  rolId     String
  permisoId String
  rol       Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso   Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
}

model UsuarioRol {
  usuarioId String
  rolId     String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol       Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@id([usuarioId, rolId])
}

// =====================================================
// SEGURIDAD: Intentos de login y bitácora
// =====================================================

model IntentoLogin {
  id        String   @id @default(cuid())
  usuarioId String?
  email     String // se guarda aunque el usuario no exista (para detectar fuerza bruta)
  exitoso   Boolean
  ip        String?
  userAgent String?
  fecha     DateTime @default(now())
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([email, fecha])
  @@index([fecha])
}

model AuditLog {
  id        String   @id @default(cuid())
  usuarioId String?
  modulo    String
  accion    String
  entidad   String // "venta", "producto", "usuario", etc.
  entidadId String?
  antes     Json?
  despues   Json?
  ip        String?
  userAgent String?
  fecha     DateTime @default(now())
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([fecha])
  @@index([usuarioId])
  @@index([entidad, entidadId])
}

// =====================================================
// PRODUCTOS Y CATÁLOGO
// =====================================================

enum TipoProducto {
  MEDICAMENTO
  ALIMENTO
  ACCESORIO
  SERVICIO
}

enum TipoPrecio {
  PUBLICO
  MAYOREO
  VETERINARIO
}

model Categoria {
  id          String     @id @default(cuid())
  nombre      String     @unique
  descripcion String?
  activa      Boolean    @default(true)
  productos   Producto[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Producto {
  id                  String                 @id @default(cuid())
  sku                 String                 @unique
  codigoBarras        String?                @unique
  nombre              String
  descripcion         String?
  marca               String?
  categoriaId         String?
  unidadMedida        String // "PZA", "KG", "ML", "DOSIS"
  tipo                TipoProducto
  especie             String? // "Canino", "Felino", "Bovino", etc.
  requiereReceta      Boolean                @default(false)
  sustanciaControlada Boolean                @default(false)
  laboratorio         String?
  viaAdministracion   String?
  claveSAT            String                 @default("01010101") // clave producto/servicio SAT
  ivaAplicable        Decimal                @default(0.16) @db.Decimal(5, 4)
  ultimoCosto         Decimal                @default(0) @db.Decimal(12, 2)
  costoPromedio       Decimal                @default(0) @db.Decimal(12, 2)
  activo              Boolean                @default(true)
  categoria           Categoria?             @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  precios             ProductoPrecio[]
  lotes               ProductoLote[]
  inventarios         Inventario[]
  movimientos         InventarioMovimiento[]
  transferenciaLineas TransferenciaLinea[]
  ventaLineas         VentaLinea[]
  proveedores         ProveedorProducto[]
  ocLineas            OcLinea[]
  recepcionLineas     RecepcionLinea[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([categoriaId])
  @@index([tipo])
  @@index([activo])
}

model ProductoPrecio {
  id         String     @id @default(cuid())
  productoId String
  tipo       TipoPrecio
  precio     Decimal    @db.Decimal(12, 2)
  producto   Producto   @relation(fields: [productoId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([productoId, tipo])
}

model ProductoLote {
  id            String                 @id @default(cuid())
  productoId    String
  lote          String
  caducidad     DateTime
  cantidad      Decimal                @default(0) @db.Decimal(14, 3)
  costoUnitario Decimal                @db.Decimal(12, 2)
  producto         Producto               @relation(fields: [productoId], references: [id], onDelete: Cascade)
  movimientos      InventarioMovimiento[]
  ventaLineas      VentaLinea[]
  recepcionLineas  RecepcionLinea[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@unique([productoId, lote])
  @@index([caducidad])
}

// =====================================================
// INVENTARIO Y KARDEX
// =====================================================

enum TipoMovimiento {
  ENTRADA // compra, devolución cliente, ajuste positivo
  SALIDA // venta, devolución proveedor, ajuste negativo
  TRANSFERENCIA // movimiento entre ubicaciones
}

enum MotivoMovimiento {
  COMPRA
  VENTA
  DEVOLUCION_CLIENTE
  DEVOLUCION_PROVEEDOR
  AJUSTE_MERMA
  AJUSTE_CADUCIDAD
  AJUSTE_ROBO
  AJUSTE_CONTEO
  TRANSFERENCIA_SALIDA
  TRANSFERENCIA_ENTRADA
  STOCK_INICIAL
}

enum EstadoTransferencia {
  PENDIENTE
  COMPLETADA
  CANCELADA
}

model Inventario {
  id          String    @id @default(cuid())
  productoId  String
  ubicacionId String
  stock       Decimal   @default(0) @db.Decimal(14, 3)
  stockMinimo Decimal   @default(0) @db.Decimal(14, 3)
  stockMaximo Decimal?  @db.Decimal(14, 3)
  producto    Producto  @relation(fields: [productoId], references: [id], onDelete: Cascade)
  ubicacion   Ubicacion @relation(fields: [ubicacionId], references: [id], onDelete: Cascade)
  updatedAt   DateTime  @updatedAt

  @@unique([productoId, ubicacionId])
  @@index([ubicacionId])
}

model InventarioMovimiento {
  id              String           @id @default(cuid())
  productoId      String
  ubicacionId     String
  loteId          String?
  tipo            TipoMovimiento
  motivo          MotivoMovimiento
  cantidad        Decimal          @db.Decimal(14, 3) // siempre positiva; tipo define el signo
  costoUnitario   Decimal?         @db.Decimal(12, 2)
  stockResultante Decimal          @db.Decimal(14, 3)
  referenciaTipo  String? // "venta", "transferencia", "ajuste"
  referenciaId    String?
  observaciones   String?
  usuarioId       String
  fecha           DateTime         @default(now())
  producto        Producto         @relation(fields: [productoId], references: [id], onDelete: Cascade)
  ubicacion       Ubicacion        @relation(fields: [ubicacionId], references: [id])
  lote            ProductoLote?    @relation(fields: [loteId], references: [id], onDelete: SetNull)
  usuario         Usuario          @relation(fields: [usuarioId], references: [id])

  @@index([productoId, fecha])
  @@index([ubicacionId, fecha])
  @@index([referenciaTipo, referenciaId])
  @@index([fecha])
}

model Transferencia {
  id            String               @id @default(cuid())
  folio         String               @unique // T-2026-00001
  origenId      String
  destinoId     String
  usuarioId     String
  estado        EstadoTransferencia  @default(PENDIENTE)
  observaciones String?
  completadaEn  DateTime?
  origen        Ubicacion            @relation("TransferenciaOrigen", fields: [origenId], references: [id])
  destino       Ubicacion            @relation("TransferenciaDestino", fields: [destinoId], references: [id])
  usuario       Usuario              @relation(fields: [usuarioId], references: [id])
  lineas        TransferenciaLinea[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([origenId])
  @@index([destinoId])
  @@index([estado])
}

model TransferenciaLinea {
  id              String        @id @default(cuid())
  transferenciaId String
  productoId      String
  cantidad        Decimal       @db.Decimal(14, 3)
  transferencia   Transferencia @relation(fields: [transferenciaId], references: [id], onDelete: Cascade)
  producto        Producto      @relation(fields: [productoId], references: [id])
}

// =====================================================
// CLIENTES
// =====================================================

enum TipoCliente {
  PUBLICO
  MAYOREO
  VETERINARIO
  GRANJA
}

model Cliente {
  id            String      @id @default(cuid())
  codigo        String      @unique // CLI-00001
  nombre        String
  rfc           String?
  regimenFiscal String?
  usoCFDI       String?
  codigoPostal  String?
  email         String?
  telefono      String?
  notas         String?
  tipoCliente   TipoCliente @default(PUBLICO)
  // Override opcional del tipo de precio. Si null, se deriva de tipoCliente.
  tipoPrecio    TipoPrecio?
  // Campos reservados para Fase 2 (crédito y cobranza). Default 0, sin uso aún.
  lineaCredito  Decimal     @default(0) @db.Decimal(12, 2)
  diasCredito   Int         @default(0)
  saldoActual   Decimal     @default(0) @db.Decimal(12, 2)
  activo        Boolean     @default(true)
  ventas        Venta[]
  abonos        ClienteAbono[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([nombre])
  @@index([rfc])
  @@index([tipoCliente])
  @@index([activo])
}

// =====================================================
// PROVEEDORES
// =====================================================

model Proveedor {
  id            String              @id @default(cuid())
  codigo        String              @unique // PRV-00001
  nombre        String
  rfc           String?
  regimenFiscal String?
  codigoPostal  String?
  email         String?
  telefono      String?
  contacto      String? // persona de contacto
  direccion     String?
  notas         String?
  // Campos reservados para Fase 2 (cuentas por pagar). Default 0, sin uso aún.
  diasCredito   Int                 @default(0)
  saldoActual   Decimal             @default(0) @db.Decimal(12, 2)
  activo        Boolean             @default(true)
  productos     ProveedorProducto[]
  ordenesCompra OrdenCompra[]
  facturas      FacturaProveedor[]
  pagos         ProveedorPago[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([nombre])
  @@index([rfc])
  @@index([activo])
}

// Catálogo de productos que ofrece cada proveedor, con su precio de costo
// y código/SKU propio del proveedor (útil para conciliar OC con facturas).
model ProveedorProducto {
  id              String    @id @default(cuid())
  proveedorId     String
  productoId      String
  codigoProveedor String? // SKU o código que el proveedor usa para identificarlo
  costoUnitario   Decimal   @default(0) @db.Decimal(12, 4)
  esPreferido     Boolean   @default(false) // marca un proveedor preferente por producto
  notas           String?
  proveedor       Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Cascade)
  producto        Producto  @relation(fields: [productoId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([proveedorId, productoId])
  @@index([productoId])
  @@index([proveedorId, esPreferido])
}

// =====================================================
// VENTAS Y CAJA
// =====================================================

enum EstadoCaja {
  ABIERTA
  CERRADA
}

enum EstadoVenta {
  COMPLETADA
  CANCELADA
}

enum FormaPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  CREDITO
}

model Caja {
  id                     String       @id @default(cuid())
  folio                  String       @unique // C-YYYY-NNNNN
  ubicacionId            String
  abiertaPorId           String
  cerradaPorId           String?
  estado                 EstadoCaja   @default(ABIERTA)
  fondoInicial           Decimal      @default(0) @db.Decimal(12, 2)
  montoEsperadoEfectivo  Decimal?     @db.Decimal(12, 2) // calculado al cierre
  montoContadoEfectivo   Decimal?     @db.Decimal(12, 2) // capturado por el cajero
  diferenciaEfectivo     Decimal?     @db.Decimal(12, 2)
  totalVendido           Decimal      @default(0) @db.Decimal(12, 2)
  observacionesApertura  String?
  observacionesCierre    String?
  abiertaEn              DateTime     @default(now())
  cerradaEn              DateTime?
  ubicacion              Ubicacion    @relation(fields: [ubicacionId], references: [id])
  abiertaPor             Usuario      @relation("CajaAbiertaPor", fields: [abiertaPorId], references: [id])
  cerradaPor             Usuario?     @relation("CajaCerradaPor", fields: [cerradaPorId], references: [id])
  ventas                 Venta[]
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@index([ubicacionId, estado])
  @@index([abiertaPorId, estado])
  @@index([abiertaEn])
}

model Venta {
  id                  String       @id @default(cuid())
  folio               String       @unique // V-YYYY-NNNNNN
  cajaId              String
  ubicacionId         String
  usuarioId           String
  clienteId           String?
  estado              EstadoVenta  @default(COMPLETADA)
  tipoPrecio          TipoPrecio   @default(PUBLICO)
  subtotal            Decimal      @default(0) @db.Decimal(12, 2) // suma de líneas sin IVA, después de descuento
  descuentoLineas     Decimal      @default(0) @db.Decimal(12, 2) // suma de descuentos por línea
  descuentoGlobal     Decimal      @default(0) @db.Decimal(12, 2)
  iva                 Decimal      @default(0) @db.Decimal(12, 2)
  total               Decimal      @default(0) @db.Decimal(12, 2)
  totalPagado         Decimal      @default(0) @db.Decimal(12, 2)
  cambio              Decimal      @default(0) @db.Decimal(12, 2)
  // Crédito otorgado en esta venta (suma de pagos con forma=CREDITO). saldoCredito
  // decrece con abonos. Cuando saldoCredito > 0, la venta aporta al saldoActual del cliente.
  montoCredito        Decimal      @default(0) @db.Decimal(12, 2)
  saldoCredito        Decimal      @default(0) @db.Decimal(12, 2)
  observaciones       String?
  motivoCancelacion   String?
  canceladaPorId      String?
  canceladaEn         DateTime?
  fechaVenta          DateTime     @default(now())
  caja                Caja         @relation(fields: [cajaId], references: [id])
  ubicacion           Ubicacion    @relation(fields: [ubicacionId], references: [id])
  usuario             Usuario      @relation("VentaUsuario", fields: [usuarioId], references: [id])
  canceladaPor        Usuario?     @relation("VentaCanceladaPor", fields: [canceladaPorId], references: [id])
  cliente             Cliente?     @relation(fields: [clienteId], references: [id])
  lineas              VentaLinea[]
  pagos               VentaPago[]
  abonosAplicados     AbonoVentaAplicacion[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([cajaId])
  @@index([ubicacionId, fechaVenta])
  @@index([usuarioId, fechaVenta])
  @@index([clienteId])
  @@index([estado])
  @@index([fechaVenta])
}

model VentaLinea {
  id              String        @id @default(cuid())
  ventaId         String
  productoId      String
  loteId          String?
  // Snapshot del producto al momento de la venta (no se altera si cambia el catálogo)
  productoSku     String
  productoNombre  String
  unidadMedida    String
  cantidad        Decimal       @db.Decimal(14, 3)
  precioUnitario  Decimal       @db.Decimal(12, 2)
  descuento       Decimal       @default(0) @db.Decimal(12, 2) // importe absoluto de descuento de la línea
  subtotal        Decimal       @db.Decimal(12, 2) // (precio*cant) - descuento, sin IVA
  ivaTasa         Decimal       @default(0) @db.Decimal(5, 4)
  ivaImporte      Decimal       @default(0) @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  venta           Venta         @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  producto        Producto      @relation(fields: [productoId], references: [id])
  lote            ProductoLote? @relation(fields: [loteId], references: [id], onDelete: SetNull)

  @@index([ventaId])
  @@index([productoId])
}

model VentaPago {
  id         String    @id @default(cuid())
  ventaId    String
  forma      FormaPago
  monto      Decimal   @db.Decimal(12, 2)
  referencia String? // últimos 4, autorización, folio de transferencia
  venta      Venta     @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  @@index([ventaId])
  @@index([forma])
}

// =====================================================
// COMPRAS: Órdenes de Compra y Recepciones de mercancía
// =====================================================

enum EstadoOrdenCompra {
  BORRADOR // se puede editar y agregar líneas
  ENVIADA // enviada al proveedor, ya no se editan líneas; admite recepciones
  RECIBIDA_PARCIAL // hay al menos una recepción pero faltan productos
  RECIBIDA_TOTAL // todas las líneas recibieron lo solicitado
  CANCELADA // anulada antes de recibir nada
}

model OrdenCompra {
  id                 String               @id @default(cuid())
  folio              String               @unique // OC-YYYY-NNNNN
  proveedorId        String
  ubicacionDestinoId String
  usuarioId          String // creador
  estado             EstadoOrdenCompra    @default(BORRADOR)
  subtotal           Decimal              @default(0) @db.Decimal(12, 2)
  iva                Decimal              @default(0) @db.Decimal(12, 2)
  total              Decimal              @default(0) @db.Decimal(12, 2)
  fechaEsperada      DateTime?
  observaciones      String?
  enviadaEn          DateTime?
  cerradaEn          DateTime?
  motivoCancelacion  String?
  canceladaPorId     String?
  canceladaEn        DateTime?
  proveedor          Proveedor            @relation(fields: [proveedorId], references: [id])
  ubicacionDestino   Ubicacion            @relation(fields: [ubicacionDestinoId], references: [id])
  usuario            Usuario              @relation("OcCreadaPor", fields: [usuarioId], references: [id])
  canceladaPor       Usuario?             @relation("OcCanceladaPor", fields: [canceladaPorId], references: [id])
  lineas             OcLinea[]
  recepciones       RecepcionMercancia[]
  facturas           FacturaProveedor[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([proveedorId])
  @@index([estado])
  @@index([ubicacionDestinoId, estado])
  @@index([createdAt])
}

model OcLinea {
  id                 String           @id @default(cuid())
  ordenCompraId      String
  productoId         String
  // Snapshot del producto al crear la OC (no cambia si el catálogo cambia)
  productoSku        String
  productoNombre     String
  unidadMedida       String
  codigoProveedor    String? // SKU del proveedor en su catálogo, al momento de crear la OC
  cantidadSolicitada Decimal          @db.Decimal(14, 3)
  cantidadRecibida   Decimal          @default(0) @db.Decimal(14, 3)
  costoUnitario      Decimal          @db.Decimal(12, 4)
  ivaTasa            Decimal          @default(0) @db.Decimal(5, 4)
  subtotal           Decimal          @db.Decimal(12, 2) // cantidadSolicitada * costoUnitario
  ivaImporte         Decimal          @default(0) @db.Decimal(12, 2)
  total              Decimal          @db.Decimal(12, 2)
  ordenCompra        OrdenCompra      @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)
  producto           Producto         @relation(fields: [productoId], references: [id])
  recepcionLineas    RecepcionLinea[]

  @@index([ordenCompraId])
  @@index([productoId])
}

model RecepcionMercancia {
  id             String           @id @default(cuid())
  folio          String           @unique // REC-YYYY-NNNNN
  ordenCompraId  String
  ubicacionId    String // dónde entró la mercancía (debe coincidir con destino de la OC)
  usuarioId     String
  observaciones String?
  fechaRecepcion DateTime         @default(now())
  ordenCompra    OrdenCompra      @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)
  ubicacion      Ubicacion        @relation(fields: [ubicacionId], references: [id])
  usuario        Usuario          @relation(fields: [usuarioId], references: [id])
  lineas         RecepcionLinea[]
  createdAt      DateTime         @default(now())

  @@index([ordenCompraId])
  @@index([ubicacionId, fechaRecepcion])
}

model RecepcionLinea {
  id            String             @id @default(cuid())
  recepcionId   String
  ocLineaId     String
  productoId    String
  cantidad      Decimal            @db.Decimal(14, 3)
  costoUnitario Decimal            @db.Decimal(12, 4) // puede diferir del costo en la OC
  // Lote y caducidad opcionales (obligatorios en UI para medicamentos/alimentos)
  lote          String?
  caducidad     DateTime?
  loteId        String? // referencia al ProductoLote creado/actualizado en la recepción
  recepcion     RecepcionMercancia @relation(fields: [recepcionId], references: [id], onDelete: Cascade)
  ocLinea       OcLinea            @relation(fields: [ocLineaId], references: [id])
  producto      Producto           @relation(fields: [productoId], references: [id])
  productoLote  ProductoLote?      @relation(fields: [loteId], references: [id], onDelete: SetNull)

  @@index([recepcionId])
  @@index([ocLineaId])
}

// =====================================================
// CUENTAS POR PAGAR: Facturas del proveedor y Pagos
// =====================================================

enum EstadoFacturaProveedor {
  PENDIENTE      // saldo > 0, sin pagos
  PAGADA_PARCIAL // saldo > 0, con al menos un pago
  PAGADA         // saldo == 0
  CANCELADA      // anulada antes o después; no afecta saldo del proveedor
}

enum FormaPagoProveedor {
  EFECTIVO
  TRANSFERENCIA
  CHEQUE
  TARJETA
  OTRO
}

enum EstadoProveedorPago {
  REGISTRADO
  CANCELADO
}

model FacturaProveedor {
  id                String                  @id @default(cuid())
  folio             String                  @unique // FCP-YYYY-NNNNN, interno
  folioProveedor    String // folio que viene en la factura del proveedor (CFDI UUID o consecutivo)
  proveedorId      String
  ordenCompraId    String?
  fechaEmision     DateTime
  fechaVencimiento DateTime
  subtotal         Decimal                 @default(0) @db.Decimal(12, 2)
  iva              Decimal                 @default(0) @db.Decimal(12, 2)
  total            Decimal                 @db.Decimal(12, 2)
  saldo            Decimal                 @db.Decimal(12, 2) // total - sum(aplicaciones activas); 0 = pagada
  estado           EstadoFacturaProveedor  @default(PENDIENTE)
  observaciones    String?
  motivoCancelacion String?
  canceladaPorId   String?
  canceladaEn      DateTime?
  usuarioId        String // quien capturó la factura
  proveedor        Proveedor               @relation(fields: [proveedorId], references: [id])
  ordenCompra      OrdenCompra?            @relation(fields: [ordenCompraId], references: [id], onDelete: SetNull)
  usuario          Usuario                 @relation("FacturaProvCapturada", fields: [usuarioId], references: [id])
  canceladaPor     Usuario?                @relation("FacturaProvCancelada", fields: [canceladaPorId], references: [id])
  aplicaciones     PagoFacturaAplicacion[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  // Un proveedor no debería repetir folio interno propio.
  @@unique([proveedorId, folioProveedor])
  @@index([proveedorId, estado])
  @@index([estado])
  @@index([fechaVencimiento])
  @@index([ordenCompraId])
}

model ProveedorPago {
  id                String                  @id @default(cuid())
  folio             String                  @unique // PAG-YYYY-NNNNN
  proveedorId       String
  fecha             DateTime                @default(now())
  formaPago         FormaPagoProveedor
  monto             Decimal                 @db.Decimal(12, 2) // monto total del pago
  referencia        String? // # transferencia / # cheque / autorización
  observaciones     String?
  estado            EstadoProveedorPago     @default(REGISTRADO)
  motivoCancelacion String?
  canceladoPorId    String?
  canceladoEn       DateTime?
  usuarioId         String
  proveedor         Proveedor               @relation(fields: [proveedorId], references: [id])
  usuario           Usuario                 @relation("PagoProvRegistrado", fields: [usuarioId], references: [id])
  canceladoPor      Usuario?                @relation("PagoProvCancelado", fields: [canceladoPorId], references: [id])
  aplicaciones      PagoFacturaAplicacion[]
  createdAt         DateTime                @default(now())

  @@index([proveedorId, fecha])
  @@index([estado])
  @@index([fecha])
}

// Distribución de un pago entre 1+ facturas. La suma de monto por pagoId debe
// igualar ProveedorPago.monto (validado en service).
model PagoFacturaAplicacion {
  id        String           @id @default(cuid())
  pagoId    String
  facturaId String
  monto     Decimal          @db.Decimal(12, 2)
  pago      ProveedorPago    @relation(fields: [pagoId], references: [id], onDelete: Cascade)
  factura   FacturaProveedor @relation(fields: [facturaId], references: [id])

  @@unique([pagoId, facturaId])
  @@index([facturaId])
}

// =====================================================
// COBRANZA: abonos del cliente y su distribución a ventas a crédito
// =====================================================

enum FormaPagoAbono {
  EFECTIVO
  TRANSFERENCIA
  CHEQUE
  TARJETA
  OTRO
}

enum EstadoClienteAbono {
  REGISTRADO
  CANCELADO
}

model ClienteAbono {
  id                String                 @id @default(cuid())
  folio             String                 @unique // ABO-YYYY-NNNNN
  clienteId         String
  fecha             DateTime               @default(now())
  formaPago         FormaPagoAbono
  monto             Decimal                @db.Decimal(12, 2)
  referencia        String?
  observaciones     String?
  estado            EstadoClienteAbono     @default(REGISTRADO)
  motivoCancelacion String?
  canceladoPorId    String?
  canceladoEn       DateTime?
  usuarioId         String
  cliente           Cliente                @relation(fields: [clienteId], references: [id])
  usuario           Usuario                @relation("AbonoRegistrado", fields: [usuarioId], references: [id])
  canceladoPor      Usuario?               @relation("AbonoCancelado", fields: [canceladoPorId], references: [id])
  aplicaciones      AbonoVentaAplicacion[]
  createdAt         DateTime               @default(now())

  @@index([clienteId, fecha])
  @@index([estado])
  @@index([fecha])
}

// Distribución de un abono entre 1+ ventas a crédito del mismo cliente.
// La suma de monto por abonoId debe igualar ClienteAbono.monto (validado en service).
model AbonoVentaAplicacion {
  id       String       @id @default(cuid())
  abonoId  String
  ventaId  String
  monto    Decimal      @db.Decimal(12, 2)
  abono    ClienteAbono @relation(fields: [abonoId], references: [id], onDelete: Cascade)
  venta    Venta        @relation(fields: [ventaId], references: [id])

  @@unique([abonoId, ventaId])
  @@index([ventaId])
}

// =====================================================
// LICENCIA (control de membresía / anti-cracking)
// =====================================================

// Una fila por instalación. Guarda el token firmado (Ed25519) que autoriza el
// uso del sistema. La verificación usa la llave pública embebida en el módulo
// `licencia`; falsificar un token requiere la llave privada del emisor, que
// nunca vive en el repo ni en la copia del cliente.
model Licencia {
  id               String    @id @default(cuid())
  token            String // JWS compacto: base64url(payload).base64url(firma)
  licenseId        String // id de licencia (del payload), para referencia
  cliente          String // negocio licenciado (visible en la UI)
  modo             String // "online" | "offline"
  instalacion      String    @unique // id único de esta copia instalada
  ultimaValidacion DateTime?
  ultimoEstado     String? // valida | gracia | expirada | invalida
  // Config del modo online (phone-home a la plataforma). Null en offline.
  apiUrl           String? // URL base de la plataforma de licencias
  claveActivacion  String? // secreto del cliente para renovar
  ultimaSync       DateTime? // última vez que se renovó/contactó la plataforma
  revocada         Boolean   @default(false) // la plataforma respondió suspendida/vencida
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}
